# ==========================================
# InvoSync Backend Environment Variables Template
# Copy this file to .env and fill in the values
# ==========================================

# Server Configuration
PORT=3000

# Database Configuration
# MongoDB connection URI (e.g., local MongoDB or MongoDB Atlas connection string)
MONGO_URI=mongodb://localhost:27017/invosync

# Authentication & Security
# Change this to a secure random string in production
JWT_SECRET=your_jwt_secret_key_here

# Redis Configuration (Used for BullMQ job queues and Socket.IO Redis adapter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Discord Webhook Integration (Optional: for audit alerts & notification rules)
DISCORD_WEBHOOK_URL=

# ==========================================
# Multi-Tenant Onboarding & Migration Scripts
# ==========================================
# Used by scripts/onboard-shop.ts and scripts/migrate-to-multitenant.ts
SHOP_NAME=Main Shop
SHOP_SLUG=main-shop
OWNER_USERNAME=admin
OWNER_PASSWORD=admin123
OWNER_NAME=Admin User
SHOP_PHONE=
SHOP_ADDRESS=
SHOP_GSTIN=
SHOP_INVOICE_PREFIX=INV
SHOP_DISCORD_WEBHOOK=

# Founding shop migration settings (used by scripts/migrate-to-multitenant.ts)
FOUNDING_SHOP_NAME=Main Shop
FOUNDING_SHOP_SLUG=main-shop
FOUNDING_SHOP_OWNER_USERNAME=admin
FOUNDING_SHOP_PHONE=
FOUNDING_SHOP_ADDRESS=
